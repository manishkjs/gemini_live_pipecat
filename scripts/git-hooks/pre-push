#!/usr/bin/env bash
#
# Local-only push guard + mandatory functional test gate.
# Shared by ALL worktrees of this repo.
#
# 1. Refuses pushes to `main` / `master` unconditionally (use a PR).
# 2. Requires `ALLOW_PUSH=1 git push origin <branch>`.
# 3. Automatically runs `./scripts/run_functional_tests.sh` before any branch push
#    unless `SKIP_FUNCTIONAL_TESTS=1` is explicitly set.
#
set -euo pipefail

readonly remote_name="${1:-origin}"
readonly z40="0000000000000000000000000000000000000000"
has_non_delete_ref=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "${local_sha}" == "${z40}" ]]; then
    continue  # branch deletion
  fi
  short_remote="${remote_ref#refs/heads/}"

  if [[ "${short_remote}" == "main" || "${short_remote}" == "master" ]]; then
    echo "pre-push: refusing to push to protected branch '${short_remote}' on '${remote_name}'." >&2
    echo "pre-push: open a pull request instead." >&2
    exit 1
  fi

  if [[ "${ALLOW_PUSH:-}" != "1" ]]; then
    echo "pre-push: blocked push of '${local_ref#refs/heads/}' -> '${remote_name}/${short_remote}'." >&2
    echo "pre-push: this repo is in local-only mode. Re-run deliberately with:" >&2
    echo "pre-push:     ALLOW_PUSH=1 git push ${remote_name} ${short_remote}" >&2
    exit 1
  fi
  has_non_delete_ref=1
done

if [[ "${has_non_delete_ref}" == "1" && "${SKIP_FUNCTIONAL_TESTS:-}" != "1" ]]; then
  repo_root="$(git rev-parse --show-toplevel)"
  if [[ -x "${repo_root}/scripts/run_functional_tests.sh" ]]; then
    echo "pre-push: running mandatory functional & unit test suite before push..." >&2
    "${repo_root}/scripts/run_functional_tests.sh"
  fi
fi

exit 0
