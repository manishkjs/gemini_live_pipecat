---
/**
 * TelephonyCostCalculator.astro
 * Pure Tokenomics & Cost Explorer for the Concepts (/pricing/) page.
 * Lets users adjust Call Duration, System Prompt Size, Turns/Interruptions per Min, and Monthly Volume
 * to see why multi-turn duplex sessions diverge from the $0.023/min single-pass streaming rate card.
 * Zero architecture spoilers—bridges cleanly to /optimization/ at the bottom.
 */
---

<div class="tcc-card" id="telephony-cost-calculator">
  <div class="tcc-header">
    <div class="tcc-badge">INTERACTIVE TOKENOMICS EXPLORER</div>
    <h3 class="tcc-title">Simulate Your Multi-Turn Duplex Telephony Cost</h3>
    <p class="tcc-subtitle">
      Adjust the sliders below to observe how turn frequency, caller barge-ins, and system prompt length compound your real-world cost per minute compared to the continuous streaming baseline.
    </p>
  </div>

  <!-- Sliders Grid -->
  <div class="tcc-controls">
    <!-- Slider 1: Call Duration -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-duration">Call Duration</label>
        <span class="tcc-val-pill" id="tcc-duration-val">3.0 mins</span>
      </div>
      <input type="range" id="tcc-duration" min="1" max="10" step="0.5" value="3" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>1 min</span>
        <span>3 mins (Typical)</span>
        <span>10 mins</span>
      </div>
    </div>

    <!-- Slider 2: System Prompt Size -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-prompt">Active Prompt &amp; Tool Schema</label>
        <span class="tcc-val-pill" id="tcc-prompt-val">4,500 tokens</span>
      </div>
      <input type="range" id="tcc-prompt" min="500" max="8000" step="250" value="4500" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>500 tok</span>
        <span>4,500 tok (Full SOP)</span>
        <span>8,000 tok</span>
      </div>
    </div>

    <!-- Slider 3: Turns per Minute -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-turns">Turns &amp; Barge-Ins / Min</label>
        <span class="tcc-val-pill" id="tcc-turns-val">6 turns/min</span>
      </div>
      <input type="range" id="tcc-turns" min="2" max="10" step="1" value="6" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>2 turns/m</span>
        <span>6 turns/m (Duplex)</span>
        <span>10 turns/m</span>
      </div>
    </div>

    <!-- Slider 4: Monthly Call Volume -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-volume">Monthly Fleet Volume</label>
        <span class="tcc-val-pill" id="tcc-volume-val">100,000 mins</span>
      </div>
      <input type="range" id="tcc-volume" min="10000" max="500000" step="10000" value="100000" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>10k mins</span>
        <span>100k mins</span>
        <span>500k mins</span>
      </div>
    </div>
  </div>

  <!-- Side-by-Side Comparison: Rate Card Slide vs Real Multi-Turn Invoice -->
  <div class="tcc-receipts-grid">
    <!-- Left Receipt: Continuous Single-Pass Baseline -->
    <div class="tcc-receipt tcc-receipt-blue">
      <div class="tcc-receipt-head">
        <span class="tcc-receipt-tag blue-tag">📘 SINGLE-PASS STREAMING BASELINE</span>
        <div class="tcc-cpm-display blue-text">$0.023 / min</div>
      </div>
      <div class="tcc-receipt-lines">
        <div class="tcc-line">
          <span>Caller Audio Input (<span class="dur-ref">3.0</span>m @ $0.005/m)</span>
          <strong id="tcc-base-in">$0.015</strong>
        </div>
        <div class="tcc-line">
          <span>Model Audio Output (<span class="dur-ref">3.0</span>m @ $0.018/m)</span>
          <strong id="tcc-base-out">$0.054</strong>
        </div>
        <div class="tcc-line">
          <span>Turn Re-Evaluation Overhead</span>
          <strong class="blue-text">$0.000 (0 turns)</strong>
        </div>
        <div class="tcc-line tcc-line-total">
          <span>Theoretical <span class="dur-ref">3.0</span>-Min Streaming Cost</span>
          <strong class="blue-text" id="tcc-base-total">$0.069</strong>
        </div>
      </div>
    </div>

    <!-- Right Receipt: Real Multi-Turn Duplex Session -->
    <div class="tcc-receipt tcc-receipt-red">
      <div class="tcc-receipt-head">
        <span class="tcc-receipt-tag red-tag">⚡ REAL MULTI-TURN DUPLEX INVOICE</span>
        <div class="tcc-cpm-display red-text" id="tcc-unopt-cpm">$0.082 / min</div>
      </div>
      <div class="tcc-receipt-lines">
        <div class="tcc-line">
          <span>Base Audio Streaming (<span class="dur-ref">3.0</span>m @ $0.023/m)</span>
          <strong id="tcc-unopt-stream">$0.069</strong>
        </div>
        <div class="tcc-line">
          <span>Prompt Re-Billing (<span id="unopt-prompt-ref">4.5k</span> tok &times; <span class="turns-ref">18</span> turns)</span>
          <strong class="red-text" id="tcc-unopt-prompt">$0.061</strong>
        </div>
        <div class="tcc-line">
          <span>Carried Caller Audio History ($3.00/M)</span>
          <strong class="red-text" id="tcc-unopt-history">$0.116</strong>
        </div>
        <div class="tcc-line tcc-line-total">
          <span>Actual Billed <span class="dur-ref">3.0</span>-Min Call Cost</span>
          <strong class="red-text" id="tcc-unopt-total">$0.246</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Insight Banner -->
  <div class="tcc-savings-banner">
    <div class="tcc-savings-left">
      <div class="tcc-savings-eyebrow">THE TURN COMPOUNDING MULTIPLIER</div>
      <div class="tcc-savings-headline">
        Multi-turn re-evaluation bills <span class="tcc-highlight-red" id="tcc-monthly-gap">$5,900 / month</span> above pure audio streaming
      </div>
      <div class="tcc-savings-note">
        At <strong id="tcc-vol-note">100,000 mins/mo</strong>, continuous streaming is <strong id="tcc-stream-mo">$2,300/mo</strong> while unoptimized multi-turn billing reaches <strong id="tcc-actual-mo">$8,200/mo</strong>.
      </div>
    </div>
    <div class="tcc-savings-badge">
      <span class="tcc-pct-number" id="tcc-mult-val">3.6&times;</span>
      <span class="tcc-pct-label">RATE CARD MULTIPLIER</span>
    </div>
  </div>
</div>

<script is:inline>
  (function initTelephonyCalculator() {
    const durInput = document.getElementById('tcc-duration');
    const promptInput = document.getElementById('tcc-prompt');
    const turnsInput = document.getElementById('tcc-turns');
    const volInput = document.getElementById('tcc-volume');

    if (!durInput || !promptInput || !turnsInput || !volInput) return;

    const durVal = document.getElementById('tcc-duration-val');
    const promptVal = document.getElementById('tcc-prompt-val');
    const turnsVal = document.getElementById('tcc-turns-val');
    const volVal = document.getElementById('tcc-volume-val');

    const durRefs = document.querySelectorAll('.dur-ref');
    const turnsRefs = document.querySelectorAll('.turns-ref');
    const unoptPromptRef = document.getElementById('unopt-prompt-ref');

    const baseInEl = document.getElementById('tcc-base-in');
    const baseOutEl = document.getElementById('tcc-base-out');
    const baseTotalEl = document.getElementById('tcc-base-total');

    const unoptCpmEl = document.getElementById('tcc-unopt-cpm');
    const unoptStreamEl = document.getElementById('tcc-unopt-stream');
    const unoptPromptEl = document.getElementById('tcc-unopt-prompt');
    const unoptHistoryEl = document.getElementById('tcc-unopt-history');
    const unoptTotalEl = document.getElementById('tcc-unopt-total');

    const monthlyGapEl = document.getElementById('tcc-monthly-gap');
    const volNoteEl = document.getElementById('tcc-vol-note');
    const streamMoEl = document.getElementById('tcc-stream-mo');
    const actualMoEl = document.getElementById('tcc-actual-mo');
    const multValEl = document.getElementById('tcc-mult-val');

    function fmtUSD(n) {
      return '$' + n.toFixed(3);
    }

    function update() {
      const duration = parseFloat(durInput.value);
      const promptTokens = parseFloat(promptInput.value);
      const turnsPerMin = parseFloat(turnsInput.value);
      const monthlyMins = parseFloat(volInput.value);

      const totalTurns = Math.round(duration * turnsPerMin);

      // Update labels
      durVal.textContent = duration.toFixed(1) + ' mins';
      promptVal.textContent = promptTokens.toLocaleString() + ' tokens';
      turnsVal.textContent = turnsPerMin + ' turns/min';
      volVal.textContent = monthlyMins.toLocaleString() + ' mins';

      durRefs.forEach(el => { el.textContent = duration.toFixed(1); });
      turnsRefs.forEach(el => { el.textContent = totalTurns; });
      unoptPromptRef.textContent = (promptTokens / 1000).toFixed(1) + 'k';

      // 1. Base Audio Streaming: $0.005/min in + $0.018/min out = $0.023/min
      const baseInCost = duration * 0.005;
      const baseOutCost = duration * 0.018;
      const baseStreamCost = baseInCost + baseOutCost;

      // 2. Prompt Re-Billing Tax ($0.75 / 1M text tokens)
      const unoptPromptCost = (totalTurns * promptTokens * 0.75) / 1000000;

      // 3. Conversational History Re-Billing
      // On each turn i (0 to totalTurns-1), prior turns are re-billed.
      // Each prior turn adds ~240 caller audio tokens ($3.00/M) + ~70 bot text tokens ($0.75/M)
      const pairs = (totalTurns * (totalTurns - 1)) / 2;
      const unoptHistoryCost = pairs * ((240 * 3.0) + (70 * 0.75)) / 1000000;

      const unoptTotal = baseStreamCost + unoptPromptCost + unoptHistoryCost;
      const unoptCpm = unoptTotal / duration;
      const mult = unoptCpm / 0.023;

      baseInEl.textContent = fmtUSD(baseInCost);
      baseOutEl.textContent = fmtUSD(baseOutCost);
      baseTotalEl.textContent = fmtUSD(baseStreamCost);

      unoptCpmEl.textContent = '$' + unoptCpm.toFixed(3) + ' / min';
      unoptStreamEl.textContent = fmtUSD(baseStreamCost);
      unoptPromptEl.textContent = fmtUSD(unoptPromptCost);
      unoptHistoryEl.textContent = fmtUSD(unoptHistoryCost);
      unoptTotalEl.textContent = fmtUSD(unoptTotal);

      const monthlyStream = 0.023 * monthlyMins;
      const monthlyActual = unoptCpm * monthlyMins;
      const monthlyGap = Math.max(0, monthlyActual - monthlyStream);

      monthlyGapEl.textContent = '$' + Math.round(monthlyGap).toLocaleString() + ' / month';
      volNoteEl.textContent = monthlyMins.toLocaleString() + ' mins/mo';
      streamMoEl.textContent = '$' + Math.round(monthlyStream).toLocaleString() + '/mo';
      actualMoEl.textContent = '$' + Math.round(monthlyActual).toLocaleString() + '/mo';
      multValEl.textContent = mult.toFixed(1) + '×';
    }

    durInput.addEventListener('input', update);
    promptInput.addEventListener('input', update);
    turnsInput.addEventListener('input', update);
    volInput.addEventListener('input', update);
    update();
  })();
</script>

<style>
  .tcc-card {
    margin: 2rem 0;
    padding: 1.5rem;
    border-radius: 14px;
    background: var(--sl-color-gray-6, #14171c);
    border: 1.5px solid var(--sl-color-gray-5, #2a2e37);
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.3);
  }
  .tcc-header {
    margin-bottom: 1.25rem;
  }
  .tcc-badge {
    display: inline-block;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    margin-bottom: 0.4rem;
  }
  .tcc-title {
    margin: 0 0 0.35rem 0 !important;
    font-size: 1.25rem !important;
    font-weight: 700;
    color: var(--sl-color-white, #ffffff);
  }
  .tcc-subtitle {
    margin: 0 !important;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3, #9ca3af);
    line-height: 1.45;
  }
  .tcc-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.1rem;
    margin-bottom: 1.5rem;
    padding: 1.1rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--sl-color-gray-5, #262932);
  }
  .tcc-control-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .tcc-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sl-color-gray-2, #e5e7eb);
  }
  .tcc-val-pill {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: #60a5fa;
  }
  .tcc-slider {
    width: 100%;
    accent-color: #3b82f6;
    cursor: pointer;
  }
  .tcc-range-hints {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--sl-color-gray-4, #6b7280);
  }
  .tcc-receipts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.1rem;
    margin-bottom: 1.25rem;
  }
  .tcc-receipt {
    padding: 1.1rem;
    border-radius: 10px;
    border: 1.2px solid transparent;
  }
  .tcc-receipt-blue {
    background: rgba(59, 130, 246, 0.06);
    border-color: rgba(59, 130, 246, 0.3);
  }
  .tcc-receipt-red {
    background: rgba(239, 68, 68, 0.06);
    border-color: rgba(239, 68, 68, 0.35);
  }
  .tcc-receipt-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px dashed var(--sl-color-gray-5, #2a2e37);
  }
  .tcc-receipt-tag {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.18rem 0.5rem;
    border-radius: 4px;
  }
  .blue-tag {
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
  }
  .red-tag {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
  }
  .tcc-cpm-display {
    font-family: var(--sl-font-mono, monospace);
    font-size: 1.15rem;
    font-weight: 800;
  }
  .blue-text {
    color: #60a5fa;
  }
  .red-text {
    color: #f87171;
  }
  .tcc-receipt-lines {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.83rem;
    color: var(--sl-color-gray-2, #d1d5db);
  }
  .tcc-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tcc-line-total {
    margin-top: 0.35rem;
    padding-top: 0.55rem;
    border-top: 1px solid var(--sl-color-gray-5, #2a2e37);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--sl-color-white, #ffffff);
  }
  .tcc-savings-banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.12) 0%, rgba(59, 130, 246, 0.12) 100%);
    border: 1px solid rgba(239, 68, 68, 0.35);
  }
  .tcc-savings-eyebrow {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #fca5a5;
    margin-bottom: 0.2rem;
  }
  .tcc-savings-headline {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--sl-color-white, #ffffff);
  }
  .tcc-highlight-red {
    color: #f87171;
    font-weight: 800;
  }
  .tcc-savings-note {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #9ca3af);
    margin-top: 0.25rem;
  }
  .tcc-savings-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: rgba(239, 68, 68, 0.18);
    border: 1px solid rgba(239, 68, 68, 0.4);
  }
  .tcc-pct-number {
    font-family: var(--sl-font-mono, monospace);
    font-size: 1.55rem;
    font-weight: 800;
    color: #f87171;
    line-height: 1.1;
  }
  .tcc-pct-label {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 700;
    color: #fecaca;
    letter-spacing: 0.05em;
  }
</style>
