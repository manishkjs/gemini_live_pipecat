---
/**
 * TelephonyCostCalculator.astro
 * Interactive Tokenomics & Cost Explorer for the dedicated /pricing-calculator/ tab.
 * Compares 3 columns side-by-side:
 *   1. Single-Pass Streaming Baseline ($0.023/min)
 *   2. Unmanaged Multi-Turn Duplex (quadratic prompt + raw caller audio history re-billing)
 *   3. Optimized Gemini Live (5k token sliding window + JIT prompt cards, staying inside the $0.02-$0.03/min Indian BPO ceiling)
 */
---

<div class="tcc-card" id="telephony-cost-calculator">
  <div class="tcc-header">
    <div class="tcc-header-top">
      <div class="tcc-badge">INTERACTIVE TOKENOMICS SIMULATOR</div>
      <div class="tcc-presets" role="group" aria-label="Scenario presets">
        <button type="button" class="tcc-preset-btn active" data-dur="3" data-prompt="4500" data-turns="6" data-vol="100000">
          3-Min Contact Center
        </button>
        <button type="button" class="tcc-preset-btn" data-dur="8" data-prompt="6000" data-turns="7" data-vol="250000">
          8-Min Technical Support
        </button>
        <button type="button" class="tcc-preset-btn" data-dur="1" data-prompt="1500" data-turns="4" data-vol="500000">
          1-Min Quick Triage
        </button>
      </div>
    </div>
    <h3 class="tcc-title">Simulate Multi-Turn Duplex Voice Unit Economics</h3>
    <p class="tcc-subtitle">
      Compare uncompacted multi-turn WebSocket billing against an optimized Gemini Live pipeline (5k sliding window + JIT prompt cards) and the <strong>$0.02–$0.03/min Indian BPO human labor ceiling</strong>.
    </p>
  </div>

  <!-- Sliders Grid -->
  <div class="tcc-controls">
    <!-- Slider 1: Call Duration -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-duration">Call Duration</label>
        <span class="tcc-val-pill" id="tcc-duration-val">3.0 mins</span>
      </div>
      <input type="range" id="tcc-duration" min="1" max="10" step="0.5" value="3" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>1 min</span>
        <span>3 mins (Typical)</span>
        <span>10 mins</span>
      </div>
    </div>

    <!-- Slider 2: System Prompt Size -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-prompt">Full SOP &amp; Tool Schema</label>
        <span class="tcc-val-pill" id="tcc-prompt-val">4,500 tokens</span>
      </div>
      <input type="range" id="tcc-prompt" min="500" max="8000" step="250" value="4500" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>500 tok</span>
        <span>4,500 tok (Full SOP)</span>
        <span>8,000 tok</span>
      </div>
    </div>

    <!-- Slider 3: Turns per Minute -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-turns">Turns &amp; Barge-Ins / Min</label>
        <span class="tcc-val-pill" id="tcc-turns-val">6 turns/min</span>
      </div>
      <input type="range" id="tcc-turns" min="2" max="10" step="1" value="6" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>2 turns/m</span>
        <span>6 turns/m (Duplex)</span>
        <span>10 turns/m</span>
      </div>
    </div>

    <!-- Slider 4: Monthly Call Volume -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-volume">Monthly Fleet Volume</label>
        <span class="tcc-val-pill" id="tcc-volume-val">100,000 mins</span>
      </div>
      <input type="range" id="tcc-volume" min="10000" max="500000" step="10000" value="100000" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>10k mins</span>
        <span>100k mins</span>
        <span>500k mins</span>
      </div>
    </div>
  </div>

  <!-- 3-Column Comparison: Streaming Baseline vs Unmanaged vs Optimized -->
  <div class="tcc-receipts-grid">
    <!-- Column 1: Continuous Single-Pass Baseline -->
    <div class="tcc-receipt tcc-receipt-blue">
      <div class="tcc-receipt-head">
        <span class="tcc-receipt-tag blue-tag">📘 SINGLE-PASS BASELINE</span>
        <div class="tcc-cpm-display blue-text">$0.023 / min</div>
      </div>
      <div class="tcc-receipt-lines">
        <div class="tcc-line">
          <span>Caller Audio Input (<span class="dur-ref">3.0</span>m @ $0.005/m)</span>
          <strong id="tcc-base-in">$0.015</strong>
        </div>
        <div class="tcc-line">
          <span>Model Audio Output (<span class="dur-ref">3.0</span>m @ $0.018/m)</span>
          <strong id="tcc-base-out">$0.054</strong>
        </div>
        <div class="tcc-line">
          <span>Turn Re-Evaluation Overhead</span>
          <strong class="blue-text">$0.000 (0 turns)</strong>
        </div>
        <div class="tcc-line tcc-line-total">
          <span>Theoretical <span class="dur-ref">3.0</span>-Min Stream</span>
          <strong class="blue-text" id="tcc-base-total">$0.069</strong>
        </div>
      </div>
    </div>

    <!-- Column 2: Unmanaged Multi-Turn Duplex Session -->
    <div class="tcc-receipt tcc-receipt-red">
      <div class="tcc-receipt-head">
        <span class="tcc-receipt-tag red-tag">⚡ UNMANAGED DUPLEX</span>
        <div class="tcc-cpm-display red-text" id="tcc-unopt-cpm">$0.082 / min</div>
      </div>
      <div class="tcc-receipt-lines">
        <div class="tcc-line">
          <span>Base Audio Streaming (<span class="dur-ref">3.0</span>m @ $0.023/m)</span>
          <strong id="tcc-unopt-stream">$0.069</strong>
        </div>
        <div class="tcc-line">
          <span>Prompt Re-Billing (<span id="unopt-prompt-ref">4.5k</span> tok &times; <span class="turns-ref">18</span> turns)</span>
          <strong class="red-text" id="tcc-unopt-prompt">$0.061</strong>
        </div>
        <div class="tcc-line">
          <span>Carried Audio History ($3.00/M)</span>
          <strong class="red-text" id="tcc-unopt-history">$0.116</strong>
        </div>
        <div class="tcc-line tcc-line-total">
          <span>Unmanaged <span class="dur-ref">3.0</span>-Min Call</span>
          <strong class="red-text" id="tcc-unopt-total">$0.246</strong>
        </div>
      </div>
    </div>

    <!-- Column 3: Optimized Gemini Live (JIT Cards + 5k Compaction) -->
    <div class="tcc-receipt tcc-receipt-green">
      <div class="tcc-receipt-head">
        <span class="tcc-receipt-tag green-tag">🚀 OPTIMIZED LIVE (JIT + 5K)</span>
        <div class="tcc-cpm-display green-text" id="tcc-opt-cpm">$0.031 / min</div>
      </div>
      <div class="tcc-receipt-lines">
        <div class="tcc-line">
          <span>Base Audio Streaming (<span class="dur-ref">3.0</span>m @ $0.023/m)</span>
          <strong id="tcc-opt-stream">$0.069</strong>
        </div>
        <div class="tcc-line">
          <span>JIT Active Prompt (~500 tok avg)</span>
          <strong class="green-text" id="tcc-opt-prompt">$0.007</strong>
        </div>
        <div class="tcc-line">
          <span>Capped Audio Window (5k limit)</span>
          <strong class="green-text" id="tcc-opt-history">$0.017</strong>
        </div>
        <div class="tcc-line tcc-line-total">
          <span>Optimized <span class="dur-ref">3.0</span>-Min Call</span>
          <strong class="green-text" id="tcc-opt-total">$0.093</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Insight Banner -->
  <div class="tcc-savings-banner">
    <div class="tcc-savings-left">
      <div class="tcc-savings-eyebrow">ARCHITECTURAL SAVINGS VS. UNMANAGED</div>
      <div class="tcc-savings-headline">
        Optimization saves <span class="tcc-highlight-green" id="tcc-monthly-saved">$5,100 / month</span> and keeps unit cost inside the Indian BPO ceiling ($0.02–$0.03/min)
      </div>
      <div class="tcc-savings-note">
        At <strong id="tcc-vol-note">100,000 mins/mo</strong>: Unmanaged costs <strong id="tcc-actual-mo">$8,200/mo</strong> vs. Optimized at <strong id="tcc-opt-mo">$3,100/mo</strong> (Indian BPO human labor @ $0.025/min = <strong id="tcc-bpo-mo">$2,500/mo</strong>).
      </div>
    </div>
    <div class="tcc-savings-badge">
      <span class="tcc-pct-number" id="tcc-pct-saved">62%</span>
      <span class="tcc-pct-label">COST REDUCTION</span>
    </div>
  </div>
</div>

<script is:inline>
  (function initTelephonyCalculator() {
    const durInput = document.getElementById('tcc-duration');
    const promptInput = document.getElementById('tcc-prompt');
    const turnsInput = document.getElementById('tcc-turns');
    const volInput = document.getElementById('tcc-volume');
    const presetBtns = document.querySelectorAll('.tcc-preset-btn');

    if (!durInput || !promptInput || !turnsInput || !volInput) return;

    const durVal = document.getElementById('tcc-duration-val');
    const promptVal = document.getElementById('tcc-prompt-val');
    const turnsVal = document.getElementById('tcc-turns-val');
    const volVal = document.getElementById('tcc-volume-val');

    const durRefs = document.querySelectorAll('.dur-ref');
    const turnsRefs = document.querySelectorAll('.turns-ref');
    const unoptPromptRef = document.getElementById('unopt-prompt-ref');

    const baseInEl = document.getElementById('tcc-base-in');
    const baseOutEl = document.getElementById('tcc-base-out');
    const baseTotalEl = document.getElementById('tcc-base-total');

    const unoptCpmEl = document.getElementById('tcc-unopt-cpm');
    const unoptStreamEl = document.getElementById('tcc-unopt-stream');
    const unoptPromptEl = document.getElementById('tcc-unopt-prompt');
    const unoptHistoryEl = document.getElementById('tcc-unopt-history');
    const unoptTotalEl = document.getElementById('tcc-unopt-total');

    const optCpmEl = document.getElementById('tcc-opt-cpm');
    const optStreamEl = document.getElementById('tcc-opt-stream');
    const optPromptEl = document.getElementById('tcc-opt-prompt');
    const optHistoryEl = document.getElementById('tcc-opt-history');
    const optTotalEl = document.getElementById('tcc-opt-total');

    const monthlySavedEl = document.getElementById('tcc-monthly-saved');
    const volNoteEl = document.getElementById('tcc-vol-note');
    const actualMoEl = document.getElementById('tcc-actual-mo');
    const optMoEl = document.getElementById('tcc-opt-mo');
    const bpoMoEl = document.getElementById('tcc-bpo-mo');
    const pctSavedEl = document.getElementById('tcc-pct-saved');

    function fmtUSD(n) {
      return '$' + n.toFixed(3);
    }

    function update() {
      const duration = parseFloat(durInput.value);
      const promptTokens = parseFloat(promptInput.value);
      const turnsPerMin = parseFloat(turnsInput.value);
      const monthlyMins = parseFloat(volInput.value);

      const totalTurns = Math.round(duration * turnsPerMin);

      // Update labels
      durVal.textContent = duration.toFixed(1) + ' mins';
      promptVal.textContent = promptTokens.toLocaleString() + ' tokens';
      turnsVal.textContent = turnsPerMin + ' turns/min';
      volVal.textContent = monthlyMins.toLocaleString() + ' mins';

      durRefs.forEach(el => { el.textContent = duration.toFixed(1); });
      turnsRefs.forEach(el => { el.textContent = totalTurns; });
      unoptPromptRef.textContent = (promptTokens / 1000).toFixed(1) + 'k';

      // 1. Base Audio Streaming: $0.005/min in + $0.018/min out = $0.023/min
      const baseInCost = duration * 0.005;
      const baseOutCost = duration * 0.018;
      const baseStreamCost = baseInCost + baseOutCost;

      // 2. Unmanaged Prompt Re-Billing ($0.75 / 1M text tokens)
      const unoptPromptCost = (totalTurns * promptTokens * 0.75) / 1000000;

      // 3. Unmanaged Conversational History Re-Billing
      // Each prior turn adds ~240 caller audio tokens ($3.00/M) + ~70 bot text tokens ($0.75/M)
      const pairs = (totalTurns * (totalTurns - 1)) / 2;
      const perTurnHistoryCost = ((240 * 3.0) + (70 * 0.75)) / 1000000;
      const unoptHistoryCost = pairs * perTurnHistoryCost;

      const unoptTotal = baseStreamCost + unoptPromptCost + unoptHistoryCost;
      const unoptCpm = unoptTotal / duration;

      // 4. Optimized Gemini Live (JIT Cards + 5k Compaction + Transcript Conversion)
      // - JIT keeps active prompt around min(promptTokens, 600) tokens on early turns, averaging ~650 tokens across the call
      const effectivePromptTokens = Math.min(promptTokens, 500 + promptTokens * 0.12);
      const optPromptCost = (totalTurns * effectivePromptTokens * 0.75) / 1000000;

      // - 5k Compaction & audio-to-text pruning caps carried audio history to the last 3 turns max, converting older turns to cheap text ($0.75/M)
      let optHistoryCost = 0;
      for (let i = 0; i < totalTurns; i++) {
        const recentAudioTurns = Math.min(i, 3);
        const olderTextTurns = Math.max(0, i - 3);
        const turnCost = (recentAudioTurns * ((240 * 3.0) + (70 * 0.75)) + olderTextTurns * (130 * 0.75)) / 1000000;
        optHistoryCost += turnCost;
      }

      const optTotal = baseStreamCost + optPromptCost + optHistoryCost;
      const optCpm = optTotal / duration;

      baseInEl.textContent = fmtUSD(baseInCost);
      baseOutEl.textContent = fmtUSD(baseOutCost);
      baseTotalEl.textContent = fmtUSD(baseStreamCost);

      unoptCpmEl.textContent = '$' + unoptCpm.toFixed(3) + ' / min';
      unoptStreamEl.textContent = fmtUSD(baseStreamCost);
      unoptPromptEl.textContent = fmtUSD(unoptPromptCost);
      unoptHistoryEl.textContent = fmtUSD(unoptHistoryCost);
      unoptTotalEl.textContent = fmtUSD(unoptTotal);

      optCpmEl.textContent = '$' + optCpm.toFixed(3) + ' / min';
      optStreamEl.textContent = fmtUSD(baseStreamCost);
      optPromptEl.textContent = fmtUSD(optPromptCost);
      optHistoryEl.textContent = fmtUSD(optHistoryCost);
      optTotalEl.textContent = fmtUSD(optTotal);

      const monthlyActual = unoptCpm * monthlyMins;
      const monthlyOpt = optCpm * monthlyMins;
      const monthlyBpo = 0.025 * monthlyMins;
      const monthlySaved = Math.max(0, monthlyActual - monthlyOpt);
      const pctSaved = unoptTotal > 0 ? Math.round(((unoptTotal - optTotal) / unoptTotal) * 100) : 0;

      monthlySavedEl.textContent = '$' + Math.round(monthlySaved).toLocaleString() + ' / month';
      volNoteEl.textContent = monthlyMins.toLocaleString() + ' mins/mo';
      actualMoEl.textContent = '$' + Math.round(monthlyActual).toLocaleString() + '/mo';
      optMoEl.textContent = '$' + Math.round(monthlyOpt).toLocaleString() + '/mo';
      bpoMoEl.textContent = '$' + Math.round(monthlyBpo).toLocaleString() + '/mo';
      pctSavedEl.textContent = pctSaved + '%';
    }

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        durInput.value = btn.getAttribute('data-dur');
        promptInput.value = btn.getAttribute('data-prompt');
        turnsInput.value = btn.getAttribute('data-turns');
        volInput.value = btn.getAttribute('data-vol');
        update();
      });
    });

    [durInput, promptInput, turnsInput, volInput].forEach(inp => {
      inp.addEventListener('input', () => {
        presetBtns.forEach(b => b.classList.remove('active'));
        update();
      });
    });

    update();
  })();
</script>

<style>
  .tcc-card {
    margin: 1.5rem 0;
    padding: 1.5rem;
    border-radius: 14px;
    background: var(--sl-color-gray-6, #14171c);
    border: 1.5px solid var(--sl-color-gray-5, #2a2e37);
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.3);
  }
  .tcc-header {
    margin-bottom: 1.25rem;
  }
  .tcc-header-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .tcc-badge {
    display: inline-block;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
  }
  .tcc-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .tcc-preset-btn {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.73rem;
    font-weight: 600;
    padding: 0.28rem 0.65rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--sl-color-gray-5, #2a2e37);
    color: var(--sl-color-gray-3, #9ca3af);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .tcc-preset-btn:hover {
    background: rgba(59, 130, 246, 0.12);
    color: #93c5fd;
    border-color: rgba(59, 130, 246, 0.4);
  }
  .tcc-preset-btn.active {
    background: rgba(59, 130, 246, 0.22);
    color: #60a5fa;
    border-color: #3b82f6;
  }
  .tcc-title {
    margin: 0 0 0.35rem 0 !important;
    font-size: 1.25rem !important;
    font-weight: 700;
    color: var(--sl-color-white, #ffffff);
  }
  .tcc-subtitle {
    margin: 0 !important;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3, #9ca3af);
    line-height: 1.45;
  }
  .tcc-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1.1rem;
    margin-bottom: 1.5rem;
    padding: 1.1rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--sl-color-gray-5, #262932);
  }
  .tcc-control-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .tcc-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sl-color-gray-2, #e5e7eb);
  }
  .tcc-val-pill {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: #60a5fa;
  }
  .tcc-slider {
    width: 100%;
    accent-color: #3b82f6;
    cursor: pointer;
  }
  .tcc-range-hints {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--sl-color-gray-4, #6b7280);
  }
  .tcc-receipts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .tcc-receipt {
    padding: 1rem;
    border-radius: 10px;
    border: 1.2px solid transparent;
  }
  .tcc-receipt-blue {
    background: rgba(59, 130, 246, 0.06);
    border-color: rgba(59, 130, 246, 0.3);
  }
  .tcc-receipt-red {
    background: rgba(239, 68, 68, 0.06);
    border-color: rgba(239, 68, 68, 0.35);
  }
  .tcc-receipt-green {
    background: rgba(16, 185, 129, 0.07);
    border-color: rgba(16, 185, 129, 0.4);
  }
  .tcc-receipt-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.65rem;
    margin-bottom: 0.65rem;
    border-bottom: 1px dashed var(--sl-color-gray-5, #2a2e37);
  }
  .tcc-receipt-tag {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.16rem 0.45rem;
    border-radius: 4px;
  }
  .blue-tag {
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
  }
  .red-tag {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
  }
  .green-tag {
    background: rgba(16, 185, 129, 0.18);
    color: #6ee7b7;
  }
  .tcc-cpm-display {
    font-family: var(--sl-font-mono, monospace);
    font-size: 1.05rem;
    font-weight: 800;
  }
  .blue-text {
    color: #60a5fa;
  }
  .red-text {
    color: #f87171;
  }
  .green-text {
    color: #34d399;
  }
  .tcc-receipt-lines {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-2, #d1d5db);
  }
  .tcc-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tcc-line-total {
    margin-top: 0.3rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--sl-color-gray-5, #2a2e37);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--sl-color-white, #ffffff);
  }
  .tcc-savings-banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(59, 130, 246, 0.12) 100%);
    border: 1px solid rgba(16, 185, 129, 0.38);
  }
  .tcc-savings-eyebrow {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #6ee7b7;
    margin-bottom: 0.2rem;
  }
  .tcc-savings-headline {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--sl-color-white, #ffffff);
  }
  .tcc-highlight-green {
    color: #34d399;
    font-weight: 800;
  }
  .tcc-savings-note {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #9ca3af);
    margin-top: 0.25rem;
  }
  .tcc-savings-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: rgba(16, 185, 129, 0.18);
    border: 1px solid rgba(16, 185, 129, 0.45);
  }
  .tcc-pct-number {
