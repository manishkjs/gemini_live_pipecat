---
/**
 * TelephonyCostCalculator.astro
 * Interactive 4-slider telephony cost & ROI simulator comparing Unoptimized Monolithic
 * vs. Optimized 3-Pillar Stack (~1,000 tokens/turn active JIT + scaffolding, audio pruning, 5k cap).
 */
---

<div class="tcc-card" id="telephony-cost-calculator">
  <div class="tcc-header">
    <div class="tcc-badge">INTERACTIVE TELEPHONY SIMULATOR</div>
    <h3 class="tcc-title">Calculate Your Real-World Call Cost &amp; Fleet Savings</h3>
    <p class="tcc-subtitle">
      Adjust the sliders below to see how turn frequency, prompt size, and call duration impact your per-minute telephony invoice—and how the 3-Pillar Stack locks in predictable economics.
    </p>
  </div>

  <!-- Sliders Grid -->
  <div class="tcc-controls">
    <!-- Slider 1: Call Duration -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-duration">Average Call Duration</label>
        <span class="tcc-val-pill" id="tcc-duration-val">3.0 mins</span>
      </div>
      <input type="range" id="tcc-duration" min="1" max="10" step="0.5" value="3" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>1 min</span>
        <span>3 mins (Typical)</span>
        <span>10 mins</span>
      </div>
    </div>

    <!-- Slider 2: System Prompt Size -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-prompt">Monolithic System Prompt Size</label>
        <span class="tcc-val-pill" id="tcc-prompt-val">4,500 tokens</span>
      </div>
      <input type="range" id="tcc-prompt" min="1000" max="8000" step="250" value="4500" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>1,000 tok</span>
        <span>4,500 tok (SOP)</span>
        <span>8,000 tok</span>
      </div>
    </div>

    <!-- Slider 3: Turns per Minute -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-turns">Turns &amp; Interruptions / Min</label>
        <span class="tcc-val-pill" id="tcc-turns-val">6 turns/min</span>
      </div>
      <input type="range" id="tcc-turns" min="3" max="10" step="1" value="6" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>3 turns/m</span>
        <span>6 turns/m (Duplex)</span>
        <span>10 turns/m</span>
      </div>
    </div>

    <!-- Slider 4: Monthly Call Volume -->
    <div class="tcc-control-group">
      <div class="tcc-label-row">
        <label for="tcc-volume">Monthly Call Volume</label>
        <span class="tcc-val-pill" id="tcc-volume-val">100,000 mins</span>
      </div>
      <input type="range" id="tcc-volume" min="10000" max="500000" step="10000" value="100000" class="tcc-slider" />
      <div class="tcc-range-hints">
        <span>10k mins</span>
        <span>100k mins</span>
        <span>500k mins</span>
      </div>
    </div>
  </div>

  <!-- Live Comparison Receipts -->
  <div class="tcc-receipts-grid">
    <!-- Left Receipt: Unoptimized -->
    <div class="tcc-receipt tcc-receipt-red">
      <div class="tcc-receipt-head">
        <span class="tcc-receipt-tag red-tag">🔴 UNOPTIMIZED MONOLITHIC</span>
        <div class="tcc-cpm-display red-text" id="tcc-unopt-cpm">$0.082 / min</div>
      </div>
      <div class="tcc-receipt-lines">
        <div class="tcc-line">
          <span>Base Audio Streaming (<span class="dur-ref">3.0</span>m @ $0.023/m)</span>
          <strong id="tcc-unopt-stream">$0.069</strong>
        </div>
        <div class="tcc-line">
          <span>Prompt Tax (<span id="unopt-prompt-ref">4.5k</span> tok &times; <span class="turns-ref">18</span> turns)</span>
          <strong class="red-text" id="tcc-unopt-prompt">$0.061</strong>
        </div>
        <div class="tcc-line">
          <span>Raw Audio History Re-Billing ($3.00/M)</span>
          <strong class="red-text" id="tcc-unopt-history">$0.116</strong>
        </div>
        <div class="tcc-line tcc-line-total">
          <span>Total <span class="dur-ref">3.0</span>-Minute Call Cost</span>
          <strong class="red-text" id="tcc-unopt-total">$0.246</strong>
        </div>
      </div>
    </div>

    <!-- Right Receipt: Optimized 3-Pillar Stack -->
    <div class="tcc-receipt tcc-receipt-green">
      <div class="tcc-receipt-head">
        <span class="tcc-receipt-tag green-tag">🟢 OPTIMIZED 3-PILLAR STACK</span>
        <div class="tcc-cpm-display green-text" id="tcc-opt-cpm">$0.033 / min</div>
      </div>
      <div class="tcc-receipt-lines">
        <div class="tcc-line">
          <span>Base Audio Streaming (<span class="dur-ref">3.0</span>m @ $0.023/m)</span>
          <strong id="tcc-opt-stream">$0.069</strong>
        </div>
        <div class="tcc-line">
          <span>JIT Cards + Scaffolding (~1.0k tok &times; <span class="turns-ref">18</span> turns)</span>
          <strong class="green-text" id="tcc-opt-prompt">$0.014</strong>
        </div>
        <div class="tcc-line">
          <span>Pruned Text History ($0.75/M) + 5k Cap</span>
          <strong class="green-text" id="tcc-opt-history">$0.017</strong>
        </div>
        <div class="tcc-line tcc-line-total">
          <span>Total <span class="dur-ref">3.0</span>-Minute Call Cost</span>
          <strong class="green-text" id="tcc-opt-total">$0.100</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Savings Banner -->
  <div class="tcc-savings-banner">
    <div class="tcc-savings-left">
      <div class="tcc-savings-eyebrow">ESTIMATED FLEET IMPACT</div>
      <div class="tcc-savings-headline">
        Save <span class="tcc-highlight-green" id="tcc-monthly-save">$4,900 / month</span>
        (<span id="tcc-yearly-save">$58,800 / year</span>)
      </div>
      <div class="tcc-savings-note">
        Plus: On the <strong>30%–50% of calls that drop in 0–5s</strong>, Card 1 (~120 tokens) cuts bounce waste by <strong>&gt;80%</strong>.
      </div>
    </div>
    <div class="tcc-savings-badge">
      <span class="tcc-pct-number" id="tcc-pct-save">60%</span>
      <span class="tcc-pct-label">COST REDUCTION</span>
    </div>
  </div>
</div>

<script is:inline>
  (function initTelephonyCalculator() {
    const durInput = document.getElementById('tcc-duration');
    const promptInput = document.getElementById('tcc-prompt');
    const turnsInput = document.getElementById('tcc-turns');
    const volInput = document.getElementById('tcc-volume');

    if (!durInput || !promptInput || !turnsInput || !volInput) return;

    const durVal = document.getElementById('tcc-duration-val');
    const promptVal = document.getElementById('tcc-prompt-val');
    const turnsVal = document.getElementById('tcc-turns-val');
    const volVal = document.getElementById('tcc-volume-val');

    const durRefs = document.querySelectorAll('.dur-ref');
    const turnsRefs = document.querySelectorAll('.turns-ref');
    const unoptPromptRef = document.getElementById('unopt-prompt-ref');

    const unoptCpmEl = document.getElementById('tcc-unopt-cpm');
    const unoptStreamEl = document.getElementById('tcc-unopt-stream');
    const unoptPromptEl = document.getElementById('tcc-unopt-prompt');
    const unoptHistoryEl = document.getElementById('tcc-unopt-history');
    const unoptTotalEl = document.getElementById('tcc-unopt-total');

    const optCpmEl = document.getElementById('tcc-opt-cpm');
    const optStreamEl = document.getElementById('tcc-opt-stream');
    const optPromptEl = document.getElementById('tcc-opt-prompt');
    const optHistoryEl = document.getElementById('tcc-opt-history');
    const optTotalEl = document.getElementById('tcc-opt-total');

    const monthlySaveEl = document.getElementById('tcc-monthly-save');
    const yearlySaveEl = document.getElementById('tcc-yearly-save');
    const pctSaveEl = document.getElementById('tcc-pct-save');

    function fmtUSD(n) {
      return '$' + n.toFixed(3);
    }

    function update() {
      const duration = parseFloat(durInput.value);
      const promptTokens = parseFloat(promptInput.value);
      const turnsPerMin = parseFloat(turnsInput.value);
      const monthlyMins = parseFloat(volInput.value);

      const totalTurns = Math.round(duration * turnsPerMin);

      // Update labels
      durVal.textContent = duration.toFixed(1) + ' mins';
      promptVal.textContent = promptTokens.toLocaleString() + ' tokens';
      turnsVal.textContent = turnsPerMin + ' turns/min';
      volVal.textContent = monthlyMins.toLocaleString() + ' mins';

      durRefs.forEach(el => { el.textContent = duration.toFixed(1); });
      turnsRefs.forEach(el => { el.textContent = totalTurns; });
      unoptPromptRef.textContent = (promptTokens / 1000).toFixed(1) + 'k';

      // 1. Base Audio Streaming: $0.005/min in + $0.018/min out = $0.023/min
      const baseStreamCost = duration * 0.023;

      // 2. Prompt Re-Billing Tax ($0.75 / 1M text tokens)
      // Unoptimized: full monolithic prompt on every turn
      const unoptPromptCost = (totalTurns * promptTokens * 0.75) / 1000000;
      // Optimized: realistic ~1,000 tokens/turn (base scaffolding + active JIT card + 1 tool)
      const optPromptTokensPerTurn = 1000;
      const optPromptCost = (totalTurns * optPromptTokensPerTurn * 0.75) / 1000000;

      // 3. Conversational History Re-Billing
      // On each turn i (0 to totalTurns-1), prior turns are re-billed.
      // Unoptimized: each prior turn adds ~240 caller audio tokens ($3.00/M) + ~70 bot text tokens ($0.75/M)
      const pairs = (totalTurns * (totalTurns - 1)) / 2;
      const unoptHistoryCost = pairs * ((240 * 3.0) + (70 * 0.75)) / 1000000;

      // Optimized:
      // - Pillar 3 converts caller audio older than 2 turns into text (~60 text tokens @ $0.75/M)
      // - Pillar 1 caps total session context at 5,000 tokens (so carried history never exceeds ~3,500 tokens)
      let optHistoryCost = 0;
      for (let t = 1; t < totalTurns; t++) {
        // Last 2 turns kept as raw audio (2 * 240 tok @ $3/M), older turns pruned to text (60 tok @ $0.75/M)
        const recentAudioTurns = Math.min(t, 2);
        const olderTextTurns = Math.max(0, t - 2);
        let carriedAudioTok = recentAudioTurns * 240;
        let carriedTextTok = (t * 70) + (olderTextTurns * 60);
        // Apply 5k total context cap (1,000 prompt + max 4,000 history)
        if (carriedAudioTok + carriedTextTok > 4000) {
          const scale = 4000 / (carriedAudioTok + carriedTextTok);
          carriedAudioTok *= scale;
          carriedTextTok *= scale;
        }
        optHistoryCost += ((carriedAudioTok * 3.0) + (carriedTextTok * 0.75)) / 1000000;
      }

      const unoptTotal = baseStreamCost + unoptPromptCost + unoptHistoryCost;
      const optTotal = baseStreamCost + optPromptCost + optHistoryCost;

      const unoptCpm = unoptTotal / duration;
      const optCpm = optTotal / duration;

      unoptCpmEl.textContent = '$' + unoptCpm.toFixed(3) + ' / min';
      unoptStreamEl.textContent = fmtUSD(baseStreamCost);
      unoptPromptEl.textContent = fmtUSD(unoptPromptCost);
      unoptHistoryEl.textContent = fmtUSD(unoptHistoryCost);
      unoptTotalEl.textContent = fmtUSD(unoptTotal);

      optCpmEl.textContent = '$' + optCpm.toFixed(3) + ' / min';
      optStreamEl.textContent = fmtUSD(baseStreamCost);
      optPromptEl.textContent = fmtUSD(optPromptCost);
      optHistoryEl.textContent = fmtUSD(optHistoryCost);
      optTotalEl.textContent = fmtUSD(optTotal);

      const monthlyUnopt = unoptCpm * monthlyMins;
      const monthlyOpt = optCpm * monthlyMins;
      const monthlySaved = Math.max(0, monthlyUnopt - monthlyOpt);
      const yearlySaved = monthlySaved * 12;
      const pctSaved = Math.round(((unoptCpm - optCpm) / unoptCpm) * 100);

      monthlySaveEl.textContent = '$' + Math.round(monthlySaved).toLocaleString() + ' / month';
      yearlySaveEl.textContent = '$' + Math.round(yearlySaved).toLocaleString() + ' / year';
      pctSaveEl.textContent = pctSaved + '%';
    }

    durInput.addEventListener('input', update);
    promptInput.addEventListener('input', update);
    turnsInput.addEventListener('input', update);
    volInput.addEventListener('input', update);
    update();
  })();
</script>

<style>
