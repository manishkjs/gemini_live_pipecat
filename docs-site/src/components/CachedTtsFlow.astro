---
/**
 * CachedTtsFlow.astro
 * Animated side-by-side: a greeting generated by Gemini Live on every call
 * versus a saved TTS clip played from memory, with the greeting text added to history.
 */
interface Props {
  caption?: string;
}
const {
  caption = "Top: Gemini Live makes the same greeting on every call, and its audio is billed again on later turns. Bottom: a saved clip plays right away, and only the short greeting text goes into the history.",
} = Astro.props;
---

<figure class="ctf-wrapper diagram-wrapper">
  <svg viewBox="0 0 840 320" role="img" aria-labelledby="ctf-title ctf-desc" class="ctf-svg">
    <title id="ctf-title">Generated greeting versus cached greeting</title>
    <desc id="ctf-desc">
      Two lanes. In the first, the call starts, Gemini Live generates the greeting, and the caller hears it after
      the model responds; about 200 output audio tokens are billed on every call and the audio stays in history.
      In the second, the call starts and a saved clip plays from memory right away with zero output tokens,
      while the greeting text, about 30 text tokens, is added to Gemini Live's history.
    </desc>

    <rect x="12" y="12" width="816" height="296" rx="14" class="card-bg" />

    <text x="36" y="44" class="main-title">Generated greeting vs. cached greeting</text>
    <text x="36" y="64" class="main-subtitle">The words are the same on every call, so you only need to make the audio once.</text>

    <!-- Lane 1: generated by Gemini Live every call -->
    <g>
      <circle cx="268" cy="116" r="5" class="dot dot-slow" />
      <text x="36" y="112" class="lane-title red-title">Generated</text>
      <text x="36" y="129" class="lane-sub">on every call</text>

      <rect x="150" y="92" width="110" height="48" rx="8" class="box-neutral" />
      <text x="205" y="120" class="box-text">Call starts</text>

      <line x1="260" y1="116" x2="290" y2="116" class="arrow" />

      <rect x="290" y="92" width="200" height="48" rx="8" class="box-red" />
      <text x="390" y="112" class="box-text red-txt">Gemini Live makes</text>
      <text x="390" y="127" class="box-text red-txt">the greeting audio</text>

      <line x1="490" y1="116" x2="520" y2="116" class="arrow" />

      <rect x="520" y="92" width="110" height="48" rx="8" class="box-neutral" />
      <text x="575" y="120" class="box-text">Caller hears it</text>

      <rect x="650" y="86" width="160" height="62" rx="8" class="badge-red" />
      <text x="730" y="111" class="badge-value red-txt">~200 audio tokens</text>
      <text x="730" y="128" class="badge-sub red-txt">output, then billed again</text>
      <text x="730" y="140" class="badge-sub red-txt">on later turns</text>

    </g>

    <!-- Lane 2: cached clip -->
    <g>
      <circle cx="268" cy="196" r="5" class="dot dot-fast" />
      <circle cx="390" cy="226" r="4" class="dot-seed" />
      <text x="36" y="192" class="lane-title green-title">Cached</text>
      <text x="36" y="209" class="lane-sub">made once, reused</text>

      <rect x="150" y="172" width="110" height="48" rx="8" class="box-neutral" />
      <text x="205" y="200" class="box-text">Call starts</text>

      <line x1="260" y1="196" x2="290" y2="196" class="arrow" />

      <rect x="290" y="172" width="200" height="48" rx="8" class="box-green" />
      <text x="390" y="192" class="box-text green-txt">Saved clip plays from</text>
      <text x="390" y="207" class="box-text green-txt">memory or Redis</text>

      <line x1="490" y1="196" x2="520" y2="196" class="arrow" />

      <rect x="520" y="172" width="110" height="48" rx="8" class="box-neutral" />
      <text x="575" y="200" class="box-text">Caller hears it</text>

      <rect x="650" y="168" width="160" height="56" rx="8" class="badge-green" />
      <text x="730" y="192" class="badge-value green-txt">0 output tokens</text>
      <text x="730" y="210" class="badge-sub green-txt">plays right away</text>

      <!-- Text seed into Gemini Live history -->
      <line x1="390" y1="220" x2="390" y2="246" class="arrow arrow-blue" />
      <rect x="290" y="246" width="340" height="44" rx="8" class="box-blue" />
      <text x="460" y="265" class="box-text blue-txt">Greeting text added to Gemini Live history</text>
      <text x="460" y="280" class="box-sub blue-txt">about 30 text tokens, so the model knows it already said hello</text>

    </g>
  </svg>

  <figcaption class="ctf-caption">{caption}</figcaption>
</figure>

<style>
  .ctf-wrapper {
    margin: 2rem 0;
    padding: 0;
  }
  .ctf-svg {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--sl-font, system-ui, sans-serif);
    overflow: visible;
  }
  .ctf-caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--gl-text-muted);
    line-height: 1.4;
  }
  .card-bg {
    fill: var(--gl-card-bg);
    stroke: var(--gl-card-border);
    stroke-width: 1.5;
  }
  .main-title {
    fill: var(--gl-text-primary);
    font-size: 15px;
    font-weight: 700;
  }
  .main-subtitle {
    fill: var(--gl-text-muted);
    font-size: 11.5px;
  }
  .lane-title {
    font-size: 13.5px;
    font-weight: 700;
  }
  .lane-sub {
    fill: var(--gl-text-muted);
    font-size: 10.5px;
  }
  .red-title { fill: var(--gl-red-text); }
  .green-title { fill: var(--gl-green-text); }

  .box-neutral {
    fill: var(--gl-track-bg);
    stroke: var(--gl-track-border);
    stroke-width: 1;
  }
  .box-red {
    fill: var(--gl-red-bg);
    stroke: var(--gl-red-border);
    stroke-width: 1;
    stroke-dasharray: 4 3;
    animation: ctf-wait 6s ease-in-out infinite;
  }
  /* The Gemini Live box pulses while the red dot waits for the model. */
  @keyframes ctf-wait {
    0%, 18%, 67%, 100% { stroke-opacity: 1; }
    30%, 55% { stroke-opacity: 0.35; }
  }
  .box-green {
    fill: var(--gl-green-bg);
    stroke: var(--gl-green-border);
    stroke-width: 1.2;
  }
  .box-blue {
    fill: var(--gl-blue-bg);
    stroke: var(--gl-blue-border);
    stroke-width: 1;
  }
  .box-text {
    fill: var(--gl-text-secondary);
    font-size: 10.5px;
    font-weight: 600;
    text-anchor: middle;
  }
  .box-sub {
    font-size: 9px;
    text-anchor: middle;
  }
  .red-txt { fill: var(--gl-red-text); }
  .green-txt { fill: var(--gl-green-text); }
  .blue-txt { fill: var(--gl-blue-text); }

  .badge-red {
    fill: var(--gl-red-bg);
    stroke: var(--gl-red-border);
    stroke-width: 1;
  }
  .badge-green {
    fill: var(--gl-green-bg);
    stroke: var(--gl-green-border);
    stroke-width: 1;
  }
  .badge-value {
    font-size: 12px;
    font-weight: 800;
    text-anchor: middle;
  }
  .badge-sub {
    font-size: 9px;
    font-weight: 600;
    text-anchor: middle;
  }

  .arrow {
    stroke: var(--gl-text-muted);
    stroke-width: 1.5;
  }
  .arrow-blue {
    stroke: var(--gl-blue-border);
    stroke-dasharray: 3 3;
  }

  .dot {
    transform-box: fill-box;
    transform-origin: center;
  }
  .dot-slow {
    fill: var(--gl-red-text);
    animation: ctf-slow 6s ease-in-out infinite;
  }
  .dot-fast {
    fill: var(--gl-green-text);
    animation: ctf-fast 6s ease-in-out infinite;
  }
  .dot-seed {
    fill: var(--gl-blue-text);
    animation: ctf-seed 6s ease-in-out infinite;
  }
  /* Dots are drawn behind the boxes and stop on the arrow just before "Caller hears it" (x=516). */
  /* Generated: waits for Gemini Live before it can reach the caller. */
  @keyframes ctf-slow {
    0% { transform: translateX(0); opacity: 0; }
    5% { opacity: 1; }
    20% { transform: translateX(18px); }
    65% { transform: translateX(18px); }
    85% { transform: translateX(248px); opacity: 1; }
    100% { transform: translateX(248px); opacity: 0; }
  }
  /* Cached: goes straight through. */
  @keyframes ctf-fast {
    0% { transform: translateX(0); opacity: 0; }
    5% { opacity: 1; }
    25% { transform: translateX(248px); opacity: 1; }
    90% { transform: translateX(248px); opacity: 1; }
    100% { transform: translateX(248px); opacity: 0; }
  }
  @keyframes ctf-seed {
    0%, 20% { transform: translateY(0); opacity: 0; }
    25% { opacity: 1; }
    40% { transform: translateY(18px); opacity: 1; }
    50%, 100% { transform: translateY(18px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ctf-svg * {
      animation: none !important;
    }
    .dot,
    .dot-seed {
      opacity: 0 !important;
    }
  }
</style>
