---
/**
 * Animated comparison: Client-Side Lossless Pruning & Rolling FactStore.
 */
interface Props {
  caption?: string;
}
const {
  caption = "Client-side lossless pruning replaces $3.00/M raw caller audio with $0.75/M text transcripts (~75% per-token rate reduction, >95% total cost reduction including token shrinkage), while a <60-token FactStore survives sliding-window FIFO eviction.",
} = Astro.props;
---

<figure class="diagram-wrapper">
  <svg viewBox="0 0 840 330" role="img" aria-labelledby="lpf-title lpf-desc" class="lpf-svg">
    <title id="lpf-title">Client-Side Lossless Pruning & Rolling FactStore</title>
    <desc id="lpf-desc">
      A visualization showing audio-to-text transcript pruning converting $3.00/M raw audio into $0.75/M text transcripts,
      and a rolling JSON FactStore under 60 tokens surviving sliding-window FIFO eviction.
    </desc>

    <!-- Outer Card Surface -->
    <rect x="12" y="12" width="816" height="306" rx="14" class="card-bg" />

    <!-- Header Section -->
    <g class="header-group">
      <text x="36" y="44" class="main-title">Client-Side Lossless Pruning &amp; FactStore</text>
      <text x="36" y="64" class="main-subtitle">
        Convert older $3.00/M raw audio into $0.75/M text transcripts while a &lt;60-token FactStore survives FIFO eviction.
      </text>
    </g>

    <!-- Lane 1: Audio-to-Text Transcript Pruning -->
    <g class="lane-group audio-text-group">
      <text x="36" y="112" class="lane-title at-title">Audio → Text</text>
      <text x="36" y="129" class="lane-sub">Turn 3+ audio eviction</text>

      <rect x="180" y="92" width="430" height="60" rx="8" class="meter-bg" />

      <rect x="186" y="98" width="164" height="48" rx="6" class="box-audio-old" />
      <text x="268" y="118" class="box-audio-title">Raw PCM Audio</text>
      <text x="268" y="132" class="box-audio-sub">1,800 tokens @ $3.00/M</text>

      <text x="372" y="126" class="convert-arrow">→</text>
      <text x="372" y="138" class="convert-tag">STT Prune</text>

      <rect x="416" y="98" width="188" height="48" rx="6" class="box-transcript" />
      <text x="510" y="118" class="box-trans-title">Text Transcript</text>
      <text x="510" y="132" class="box-trans-sub">300 tokens @ $0.75/M (Text)</text>

      <rect x="630" y="92" width="176" height="60" rx="8" class="badge-bg green-badge" />
      <text x="718" y="117" class="badge-value green-txt">4&times; LOWER RATE</text>
      <text x="718" y="135" class="badge-sub green-sub">Transcripts @ $0.75/M</text>
    </g>

    <!-- Lane 2: Rolling FactStore Survival -->
    <g class="lane-group factstore-group">
      <text x="36" y="202" class="lane-title fs-title">FactStore</text>
      <text x="36" y="219" class="lane-sub">Survives FIFO eviction</text>

      <rect x="180" y="174" width="430" height="114" rx="8" class="meter-bg" />

      <rect x="186" y="180" width="418" height="34" rx="6" class="bar-evicted" />
      <text x="395" y="196" class="evicted-title">FIFO Eviction Boundary: Turns 1 to 5 pruned from window</text>
      <text x="395" y="208" class="evicted-sub">Older dialogue evicted to stay under token budget</text>

      <rect x="186" y="222" width="418" height="58" rx="6" class="box-factstore" />
      <text x="198" y="242" class="fs-code">&#123;"caller_name": "Vikram", "postal_code": "110001", "tier": "AMG GT"&#125;</text>
      <text x="198" y="262" class="fs-desc">Persistent JSON FactStore · Survives sliding window · Zero memory loss</text>

      <rect x="630" y="192" width="176" height="78" rx="8" class="badge-bg green-badge" />
      <text x="718" y="218" class="badge-value green-txt">&lt; 60 TOKENS</text>
      <text x="718" y="236" class="badge-sub green-sub">ZERO MEMORY LOSS</text>
      <text x="718" y="252" class="badge-detail green-sub">Key Facts Intact</text>
    </g>
  </svg>

  <figcaption class="diagram-caption">{caption}</figcaption>
</figure>

<style>
  .diagram-wrapper {
    margin: 2rem 0;
    padding: 0;
  }
  .lpf-svg {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--sl-font, system-ui, sans-serif);
    overflow: visible;
  }
  .diagram-caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--gl-text-muted);
    line-height: 1.4;
  }
  .card-bg {
    fill: var(--gl-card-bg);
    stroke: var(--gl-card-border);
    stroke-width: 1.5;
  }
  .main-title {
    fill: var(--gl-text-primary);
    font-size: 15px;
    font-weight: 700;
  }
  .main-subtitle {
    fill: var(--gl-text-muted);
    font-size: 11.5px;
  }
  .lane-title {
    font-size: 13.5px;
    font-weight: 700;
  }
  .lane-sub {
    fill: var(--gl-text-muted);
    font-size: 10.5px;
  }
  .at-title {
    fill: var(--gl-blue-text);
  }
  .fs-title {
    fill: var(--gl-green-text);
  }
  .meter-bg {
    fill: var(--gl-track-bg);
    stroke: var(--gl-track-border);
    stroke-width: 1;
  }
  .box-audio-old {
    fill: var(--gl-red-bg);
    stroke: var(--gl-red-border);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }
  .box-audio-title, .box-audio-sub {
    fill: var(--gl-red-text);
    font-size: 9.5px;
    font-weight: 600;
    text-anchor: middle;
  }
  .convert-arrow, .convert-tag {
    fill: var(--gl-blue-text);
    font-size: 10px;
    font-weight: 700;
    text-anchor: middle;
  }
  .box-transcript {
    fill: var(--gl-blue-bg);
    stroke: var(--gl-blue-border);
    stroke-width: 1;
  }
  .box-trans-title, .box-trans-sub {
    fill: var(--gl-blue-text);
    font-size: 9.5px;
    font-weight: 600;
    text-anchor: middle;
  }
  .bar-evicted {
    fill: var(--gl-red-bg);
    stroke: var(--gl-red-border);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .evicted-title {
    fill: var(--gl-red-text);
    font-size: 9.5px;
    font-weight: 600;
    text-anchor: middle;
  }
  .evicted-sub {
    fill: var(--gl-text-muted);
    font-size: 8px;
    text-anchor: middle;
  }
  .box-factstore {
    fill: var(--gl-green-bg);
    stroke: var(--gl-green-border);
    stroke-width: 1.2;
  }
  .fs-code {
    fill: var(--gl-green-text);
    font-family: var(--sl-font-mono, monospace);
    font-size: 10px;
    font-weight: 600;
  }
  .fs-desc {
    fill: var(--gl-text-secondary);
    font-size: 9px;
  }
  .badge-bg {
    stroke-width: 1;
  }
  .green-badge {
    fill: var(--gl-green-bg);
    stroke: var(--gl-green-border);
  }
  .badge-value {
    font-size: 13px;
    font-weight: 800;
    text-anchor: middle;
    letter-spacing: 0.04em;
  }
  .badge-sub, .badge-detail {
    font-size: 9px;
    font-weight: 600;
    text-anchor: middle;
  }
  .green-txt, .green-sub {
    fill: var(--gl-green-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .lpf-svg * {
      animation: none !important;
    }
  }
</style>
