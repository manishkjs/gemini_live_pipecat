# Vertex AI Configuration
GOOGLE_APPLICATION_CREDENTIALS=""
GCP_PROJECT_ID="deep-clock-339817"
GCP_LOCATION="us-central1"

# Google Cloud Vertex AI Agent Memory (Reasoning Engine / Memory Bank)
# Format: projects/{PROJECT_ID}/locations/{LOCATION}/reasoningEngines/{ENGINE_ID}
MEMORY_BANK_RESOURCE_ID=""

# Voice Cloning Keys from TTS provider (Chirp3 HD)
CLONE_TTS_VOICE_KEY_MALE=""
CLONE_TTS_VOICE_KEY_FEMALE=""

# Embedded Mem0 Fallback (used automatically when MEMORY_BANK_RESOURCE_ID is not set)
MEM0_DB_PATH="./data/mem0_qdrant_db"

# ==============================================================================
# Voice Latency & Turn-Taking Optimization Configuration
# ==============================================================================

# Tool Profile: "lean" (4 real-time conversational tools) or "full" (all 6 tools)
TOOL_PROFILE="lean"

# Tier-2 Intent Classifier Timeout (seconds) for asynchronous fallback
TIER2_CLASSIFIER_TIMEOUT_S="2.5"

# Max Transcript History Turns bounded for Tier-2 Intent Classifier
TIER2_MAX_HISTORY_TURNS="8"

# Silero VAD end-of-speech silence duration threshold (seconds)
VAD_STOP_SECS="0.4"

# User Turn Strategy speech timeout duration (seconds)
USER_SPEECH_TIMEOUT_S="0.6"

# Asynchronous non-blocking L2 Redis writeback for RAG knowledge cache
RAG_L2_WRITE_ASYNC="true"

